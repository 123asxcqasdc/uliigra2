#!/usr/bin/env bash
# ============================================================
#  Dial Forward — installer (Linux, bash)
#  Работает на голой системе БЕЗ python:
#      curl -sL https://uliigra2.c6t.ru/dial-forward/installer | bash
#  Устанавливает: python, gstreamer, приложение, ярлык на рабочий стол.
# ============================================================
set -euo pipefail

GITHUB_RAW="https://raw.githubusercontent.com/123asxcqasdc/uliigra2/main/dial-forward"
MIRROR_BASE="https://uliigra2.c6t.ru/dial-forward"
APP_DIR="${1:-$HOME/dial-forward}"

say()  { printf '\033[1;32m[installer]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[installer]\033[0m %s\n' "$*"; }

if [ "$(uname -s)" != "Linux" ]; then
  warn "Это Linux-установщик. На Windows:"
  warn "  curl -o installer.ps1 $MIRROR_BASE/installer.ps1"
  warn "  powershell -ExecutionPolicy Bypass -File installer.ps1"
  exit 1
fi

say "Архитектура: $(uname -m) ($(uname -s))"

# ---------- 1. системные пакеты ----------
install_system_deps() {
  if command -v apt-get >/dev/null 2>&1; then
    say "Debian/Ubuntu — apt"
    sudo apt-get update
    sudo apt-get install -y python3 python3-venv python3-pip python3-gi python3-gi-cairo python3-pil \
      gir1.2-gstreamer-1.0 gir1.2-gst-plugins-base-1.0 gir1.2-gst-plugins-bad-1.0 \
      gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
      gstreamer1.0-plugins-ugly gstreamer1.0-libav gstreamer1.0-nice gstreamer1.0-x \
      git curl unzip
  elif command -v dnf >/dev/null 2>&1; then
    say "Fedora/RHEL — dnf"
    sudo dnf install -y python3 python3-devel python3-pip python3-gobject python3-pillow \
      gstreamer1-devel gstreamer1-plugins-base gstreamer1-plugins-good \
      gstreamer1-plugins-bad gstreamer1-plugins-ugly gstreamer1-libav gstreamer1-nice \
      git curl unzip
  elif command -v pacman >/dev/null 2>&1; then
    say "Arch — pacman"
    sudo pacman -Sy --noconfirm python python-pip python-gobject python-pillow gst-python \
      gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad gst-plugins-ugly \
      gst-libav gst-plugin-pipewire git curl unzip
  else
    warn "Пакетный менеджер не распознан. Установите вручную:"
    warn "  python3, python3-venv, python3-pip, python3-gi, gstreamer + плагины, git, curl, unzip"
    exit 1
  fi
}

# ---------- 2. код приложения ----------
fetch_file() {  # fetch_file <remote_path> <local_path>
  if ! curl -fsSL --max-time 30 "$GITHUB_RAW/$1" -o "$2"; then
    curl -fsSL --max-time 30 "$MIRROR_BASE/$1" -o "$2"
  fi
}

fetch_code() {
  mkdir -p "$APP_DIR/client" "$APP_DIR/relay"
  say "Качаю код приложения..."
  for f in app.py call.py protocol.py relay_client.py webrtc.py; do
    fetch_file "client/$f" "$APP_DIR/client/$f"
  done
  fetch_file "relay/relay.py" "$APP_DIR/relay/relay.py"
  fetch_file "launcher.py" "$APP_DIR/launcher.py"
  fetch_file "requirements.txt" "$APP_DIR/requirements.txt"
  chmod +x "$APP_DIR/launcher.py"
}

# ---------- 3. python-окружение ----------
setup_env() {
  say "Создаю виртуальное окружение (со системными gi/pillow)..."
  # --system-site-packages: PyGObject и Pillow ставятся системными пакетами,
  # потому что pip-колёс для них нет на всех архитектурах (напр. 32-бит).
  python3 -m venv --system-site-packages "$APP_DIR/.venv"
  "$APP_DIR/.venv/bin/pip" install --upgrade pip >/dev/null
  say "Устанавливаю python-библиотеки (pillow уже из системы)..."
  if "$APP_DIR/.venv/bin/pip" install -r "$APP_DIR/requirements.txt" 2>/dev/null; then
    :
  else
    warn "pip-установка частично не удалась — ставлю без pillow (системный уже есть)"
    grep -v "^pillow" "$APP_DIR/requirements.txt" > /tmp/df-req.txt
    "$APP_DIR/.venv/bin/pip" install -r /tmp/df-req.txt || true
  fi
}

# ---------- 4. ярлык на рабочий стол ----------
create_shortcut() {
  local apps="$HOME/.local/share/applications"
  mkdir -p "$apps"
  cat > "$apps/dial-forward.desktop" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Dial Forward
Comment=P2P звонки через Telegram
Exec=$APP_DIR/.venv/bin/python $APP_DIR/launcher.py
Path=$APP_DIR
Terminal=false
Categories=Network;Telephony;
EOF
  chmod +x "$apps/dial-forward.desktop"
  say "Ярлык: $apps/dial-forward.desktop"
}

say "Dial Forward installer"
install_system_deps
fetch_code
setup_env
create_shortcut
say "Готово! Запуск: $APP_DIR/.venv/bin/python $APP_DIR/launcher.py"
say "или через меню приложений: Dial Forward"
